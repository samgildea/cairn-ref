{
  "name": "cairn",
  "displayName": "Cairn",
  "description": "See and edit a GitHub stacked-PR chain as one column of cards, powered by the gh stack CLI extension.",
  "version": "0.1.0",
  "publisher": "cairn-dev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "stacked pull requests",
    "gh stack",
    "stacked diffs",
    "github"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cairn",
          "title": "Cairn",
          "icon": "media/cairn.svg"
        }
      ]
    },
    "views": {
      "cairn": [
        {
          "type": "webview",
          "id": "cairn.stack",
          "name": "Stack",
          "icon": "media/cairn.svg",
          "contextualTitle": "Cairn"
        }
      ]
    },
    "commands": [
      { "command": "cairn.refresh", "title": "Refresh", "category": "Cairn", "icon": "$(refresh)" },
      { "command": "cairn.fetch", "title": "Fetch (git fetch --prune)", "category": "Cairn", "icon": "$(cloud-download)" },
      { "command": "cairn.checkout", "title": "Check Out Layer…", "category": "Cairn" },
      { "command": "cairn.up", "title": "Up One Layer (gh stack up)", "category": "Cairn" },
      { "command": "cairn.down", "title": "Down One Layer (gh stack down)", "category": "Cairn" },
      { "command": "cairn.top", "title": "Go to Top of Stack (gh stack top)", "category": "Cairn" },
      { "command": "cairn.bottom", "title": "Go to Bottom of Stack (gh stack bottom)", "category": "Cairn" },
      { "command": "cairn.addBranch", "title": "Add Branch on Top…", "category": "Cairn" },
      { "command": "cairn.newStack", "title": "New Stack…", "category": "Cairn", "icon": "$(add)" },
      { "command": "cairn.submit", "title": "Submit Stack (draft PRs)", "category": "Cairn", "icon": "$(cloud-upload)" },
      { "command": "cairn.submitReady", "title": "Submit Stack and Mark Ready for Review", "category": "Cairn" },
      { "command": "cairn.publish", "title": "Publish Reorder (push, then submit)", "category": "Cairn" },
      { "command": "cairn.undo", "title": "Undo Reorder", "category": "Cairn" },
      { "command": "cairn.rebaseUpstack", "title": "Rebase Upstack (gh stack rebase --upstack)", "category": "Cairn" },
      { "command": "cairn.rebaseContinue", "title": "Continue Rebase", "category": "Cairn" },
      { "command": "cairn.rebaseAbort", "title": "Abort Rebase", "category": "Cairn" },
      { "command": "cairn.sync", "title": "Sync Stack (gh stack sync)", "category": "Cairn" },
      { "command": "cairn.merge", "title": "Merge Stack…", "category": "Cairn" },
      { "command": "cairn.unstackLocal", "title": "Stop Tracking Stack Locally", "category": "Cairn" },
      { "command": "cairn.unstack", "title": "Unstack on GitHub and Locally…", "category": "Cairn" },
      { "command": "cairn.openWorktree", "title": "Open Layer in New Worktree…", "category": "Cairn" },
      { "command": "cairn.installGhStack", "title": "Install gh stack Extension", "category": "Cairn" },
      { "command": "cairn.showOutput", "title": "Show Output", "category": "Cairn", "icon": "$(output)" }
    ],
    "menus": {
      "view/title": [
        { "command": "cairn.fetch", "when": "view == cairn.stack", "group": "navigation@1" },
        { "command": "cairn.refresh", "when": "view == cairn.stack", "group": "navigation@2" },
        { "command": "cairn.sync", "when": "view == cairn.stack", "group": "1_stack@1" },
        { "command": "cairn.rebaseUpstack", "when": "view == cairn.stack", "group": "1_stack@2" },
        { "command": "cairn.newStack", "when": "view == cairn.stack", "group": "navigation@0" },
        { "command": "cairn.addBranch", "when": "view == cairn.stack", "group": "1_stack@3" },
        { "command": "cairn.merge", "when": "view == cairn.stack", "group": "2_github@1" },
        { "command": "cairn.submitReady", "when": "view == cairn.stack", "group": "2_github@2" },
        { "command": "cairn.unstackLocal", "when": "view == cairn.stack", "group": "4_danger@1" },
        { "command": "cairn.unstack", "when": "view == cairn.stack", "group": "4_danger@2" },
        { "command": "cairn.showOutput", "when": "view == cairn.stack", "group": "5_output@1" }
      ]
    },
    "configuration": {
      "title": "Cairn",
      "properties": {
        "cairn.ghPath": {
          "type": "string",
          "default": "gh",
          "scope": "machine",
          "markdownDescription": "Path to the GitHub CLI binary. Defaults to `gh` on `PATH`. Cairn needs the `gh stack` extension installed for this binary."
        },
        "cairn.remote": {
          "type": "string",
          "default": "origin",
          "scope": "resource",
          "markdownDescription": "Remote passed as `--remote` to `gh stack push`, `submit`, `sync`, and `rebase`."
        },
        "cairn.syncInterval": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "scope": "resource",
          "markdownDescription": "Seconds between background syncs while the Cairn view is visible and the window is focused. Each sync runs `git fetch --prune` on `#cairn.remote#` and re-reads PR status, CI, and reviews from GitHub. `0` turns background sync off."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/webview/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "./scripts/make-demo-stack.sh .demo/stack",
    "harness": "esbuild scripts/harness/run.ts --bundle --platform=node --format=cjs --outfile=.harness/run.js --alias:vscode=./scripts/harness/vscode-stub.ts --log-level=warning"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "~1.99.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
